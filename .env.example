# Copy to .env for local development (.env is gitignored).
# Ports are registered in ~/coding/PORTS.md — orqy dev owns 3457, 3458, 5443.

# Dev Postgres from docker-compose.dev.yml (host port 5443)
DATABASE_URL=postgres://orqy:orqy@localhost:5443/orqy

# Backend port. 3456 is production orqy on optiplex; dev uses 3457.
PORT=3457

# Key for encrypting PATs at rest. Any non-default string is fine locally,
# but changing it makes previously stored PATs undecryptable.
ENCRYPTION_SECRET=dev-only-not-a-real-secret

RUST_LOG=orqy=debug

# Support ticket button. Defaults point at the Orqy backlog on
# backend.gilroy.digital; override to send reports somewhere else.
# TICKET_API_URL=https://backend.gilroy.digital/api/public/tickets/
# TICKET_BUSINESS_REF=ce09e735-38cf-40da-8504-f2b60bc04855
